  <property name="styleSheet">
   <string>QFrame#navigationPanel { background: #F1F5F9; border: 1px solid #D7E0EA; border-radius: 8px; }
QFrame#navigationPanel QLabel { color: #243447; font-size: 11pt; }
QPushButton { min-height: 38px; padding: 5px 8px; border: 1px solid #C7D0DB; border-radius: 5px; background: white; color: #263445; font-size: 11pt; }
QPushButton:hover { background: #DCEAF8; border-color: #7EA9D6; }
QPushButton:pressed { background: #C4DCF3; }
QTabBar::tab { font-family: "B Nazanin"; font-size: 14pt; font-weight: bold; min-height: 42px; padding: 6px 15px; background: #E8EEF5; color: #263445; border: 1px solid #C7D0DB; }
QTabBar::tab:selected { background: white; color: #1565A8; border-top: 3px solid #1976D2; }
QTabWidget::pane { border: 1px solid #C7D0DB; background: white; }

/* کارت‌های اتاق: ساختار و ظاهر ثابت در main.ui؛ Python فقط وضعیت/متن هر کارت را تعیین می‌کند. */
QPushButton#hotelRoomCardButton { text-align: center; padding: 9px; border: 1px solid #C9CED4; border-radius: 10px; color: #667085; background: #F1F3F5; font-family: "B Nazanin"; font-size: 11pt; font-weight: bold; }
QPushButton#hotelRoomCardButton[hotelStatus="vacant"] { background: #F0F9F3; border-color: #8CC9A0; color: #21864B; }
QPushButton#hotelRoomCardButton[hotelStatus="occupied"] { background: #FFF3F1; border-color: #E6A39B; color: #B9382B; }
QPushButton#hotelRoomCardButton[hotelStatus="reserved"] { background: #FFF7E8; border-color: #E7C078; color: #996515; }
QPushButton#hotelRoomCardButton:hover { border-width: 2px; }
</string>
